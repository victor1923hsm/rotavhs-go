<?xml version="1.0" encoding="utf-8"?>
<!-- SÓ NO APK DO TESTE AUTOMÁTICO (gradle -PrvTesteLocal): permite HTTP para o servidor de respostas controladas
     no próprio aparelho (127.0.0.1, via "adb reverse"). O APK entregue (teste.N) não usa este arquivo. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
