<?xml version="1.0" encoding="utf-8"?>
<!-- Privacidade: a rota (endereços, códigos SPX, coordenadas) fica SÓ no aparelho.
     Nenhum backup na nuvem nem cópia para outro aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
